<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bonkilingo.shared</string>
	</array>
	<!-- The app's own group first: it stays the default for Keychain items
	     written without a group, so those remain private to the app. The
	     shared group holds only the keyboard token (keyboard_auth_service.dart). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bonkilingo.ios</string>
		<string>$(AppIdentifierPrefix)com.bonkilingo.shared</string>
	</array>
</dict>
</plist>
